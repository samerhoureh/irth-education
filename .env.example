# ─────────────────────────────────────────────────────────────
# أرث التعليم العربي — Irth Arabic Education
# انسخ هذا الملف إلى ‎.env ثم عدّل القيم:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# قاعدة البيانات (SQLite)
# المسار نسبي لمجلد prisma — سيُنشأ الملف تلقائياً عند db:push
DATABASE_URL="file:../db/custom.db"

# ─── بوابة الذكاء الاصطناعي (المعلم الذكي، التحقق من كتب، الصوت) ───
# ضع رابط بوابتك المتوافقة مع واجهة المحادثات ومفتاحها
AI_GATEWAY_BASE_URL="https://your-ai-gateway.example.com/v1"
AI_GATEWAY_API_KEY="ضع-مفتاح-البوابة-هنا"
# اختياري: ترويسات إضافية تشترطها بوابتك (بصيغة JSON)
# AI_GATEWAY_EXTRA_HEADERS={"X-Custom-Header":"value"}

# مفتاح تشفير الجلسات — ولّد قيمة عشوائية طويلة، مثال:  openssl rand -hex 32
AUTH_SECRET="ضع-هنا-مفتاحاً-عشوائياً-طويلاً"

# ─── حسابات الإدارة والمعلمين (تستخدمها سكربتات البذر) ───
ADMIN_NAME="مدير المنصة"
ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD="كلمة-مرور-قوية-للإدارة"
TEACHER_NAME="معلم المنصة"
TEACHER_EMAIL="teacher@example.org"
TEACHER_PASSWORD="كلمة-مرور-قوية-للمعلم"

# كلمة مرور حسابات الداعمين التجريبية (سكربت seed:sponsors)
SPONSOR_DEMO_PASSWORD="كلمة-مرور-تجريبية"
